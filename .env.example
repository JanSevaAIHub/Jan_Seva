# Browser-visible values. Never put service-role or model keys here.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# API-only values; configure on the server, not in the frontend.
# PostgreSQL URL from your provider. No default or fallback database is used.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Phase 3 uses the OpenAI Responses API with strict JSON-schema output.
# Choose an available model supporting that API/format; no model is assumed.
LLM_MODEL=
# OpenAI embedding model, e.g. text-embedding-3-small. No offline/mock fallback.
EMBEDDING_MODEL=
# Actual output dimension for EMBEDDING_MODEL; required only when storing vectors.
EMBEDDING_DIMENSIONS=
# Cosine relevance cutoff (not an eligibility/confidence percentage).
# Calibrate against the live five-question evaluation for your configured model.
RAG_MIN_SCORE=0.35
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional explicit demo operator commands. Never used by normal app startup.
# Emails are required for demo lookup; passwords only for NEW Auth identities.
DEMO_CITIZEN_EMAIL=
DEMO_CITIZEN_PASSWORD=
DEMO_OFFICER_EMAIL=
DEMO_OFFICER_PASSWORD=

# Optional explicit assignment of this demo citizen's NEW tickets only.
# Use the real UUIDs returned by Supabase Auth; both profiles must be provisioned.
DEMO_CITIZEN_USER_ID=
DEMO_OFFICER_USER_ID=

